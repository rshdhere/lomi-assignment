{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["NEXT_PUBLIC_API_ORIGIN"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/fixtures/**"],
      "env": ["RUN_DB_TESTS"],
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "OPENAI_BASE_URL",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "EMBEDDING_MODEL",
    "PORT",
    "UI_ORIGIN",
    "TRUST_SINGLE_PROXY",
    "WORKER_CONCURRENCY",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_PROTOCOL",
    "OTEL_METRIC_EXPORT_INTERVAL",
    "OTEL_SDK_DISABLED",
    "MAX_FILE_BYTES",
    "MAX_BATCH_FILES",
    "UPLOADS_PER_MINUTE",
    "QUERIES_PER_MINUTE",
    "REVIEWS_PER_MINUTE",
    "FIXTURES_DIR",
    "S3_BUCKET",
    "S3_REGION",
    "S3_ENDPOINT",
    "S3_PUBLIC_ENDPOINT",
    "PDF_PARSER_SOCKET",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN"
  ]
}
