{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateTagged",
      "Effect": "Allow",
      "Action": ["ec2:CreateSecurityGroup", "ec2:AllocateAddress"],
      "Resource": [
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:security-group/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:elastic-ip/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Application": "lomi",
          "aws:RequestTag/Environment": "{{ENVIRONMENT}}",
          "aws:RequestTag/ManagedBy": "terraform"
        }
      }
    },
    {
      "Sid": "CreateRule",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress"
      ],
      "Resource": "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:security-group-rule/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Application": "lomi",
          "aws:RequestTag/Environment": "{{ENVIRONMENT}}",
          "aws:RequestTag/ManagedBy": "terraform"
        }
      }
    },
    {
      "Sid": "UseGroup",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:DeleteSecurityGroup",
        "ec2:ModifySecurityGroupRules"
      ],
      "Resource": "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Application": "lomi",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/ManagedBy": "terraform"
        }
      }
    },
    {
      "Sid": "UpdateRule",
      "Effect": "Allow",
      "Action": "ec2:ModifySecurityGroupRules",
      "Resource": "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:security-group-rule/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Application": "lomi",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/ManagedBy": "terraform"
        }
      }
    },
    {
      "Sid": "BirthTags",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:instance/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:volume/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:security-group/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:security-group-rule/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:elastic-ip/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateVolume",
            "CreateSecurityGroup",
            "AuthorizeSecurityGroupIngress",
            "AuthorizeSecurityGroupEgress",
            "AllocateAddress"
          ]
        }
      }
    },
    {
      "Sid": "MutableLabels",
      "Effect": "Allow",
      "Action": ["ec2:CreateTags", "ec2:DeleteTags"],
      "Resource": [
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:instance/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:volume/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:security-group/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:security-group-rule/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:elastic-ip/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Application": "lomi",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/ManagedBy": "terraform"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["Name", "LomiBackup"]
        },
        "Null": {
          "aws:TagKeys": "false"
        }
      }
    },
    {
      "Sid": "HostLifecycle",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstanceAttribute",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:AssociateAddress"
      ],
      "Resource": "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Application": "lomi",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/ManagedBy": "terraform"
        }
      }
    },
    {
      "Sid": "ManageDisk",
      "Effect": "Allow",
      "Action": ["ec2:ModifyVolume", "ec2:AttachVolume", "ec2:DetachVolume"],
      "Resource": "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Application": "lomi",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/ManagedBy": "terraform"
        }
      }
    },
    {
      "Sid": "UseAddress",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateAddress",
        "ec2:DisassociateAddress",
        "ec2:ReleaseAddress"
      ],
      "Resource": "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:elastic-ip/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Application": "lomi",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/ManagedBy": "terraform"
        }
      }
    },
    {
      "Sid": "DlmCreate",
      "Effect": "Allow",
      "Action": "dlm:CreateLifecyclePolicy",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Application": "lomi",
          "aws:RequestTag/Environment": "{{ENVIRONMENT}}",
          "aws:RequestTag/ManagedBy": "terraform",
          "aws:RequestedRegion": "{{REGION}}"
        }
      }
    },
    {
      "Sid": "DlmCreateTags",
      "Effect": "Allow",
      "Action": "dlm:TagResource",
      "Resource": "arn:aws:dlm:{{REGION}}:{{ACCOUNT_ID}}:policy/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Application": "lomi",
          "aws:RequestTag/Environment": "{{ENVIRONMENT}}",
          "aws:RequestTag/ManagedBy": "terraform"
        },
        "StringEqualsIfExists": {
          "aws:ResourceTag/Application": "lomi",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/ManagedBy": "terraform"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["Application", "Environment", "ManagedBy"]
        }
      }
    },
    {
      "Sid": "DlmLifecycle",
      "Effect": "Allow",
      "Action": [
        "dlm:GetLifecyclePolicy",
        "dlm:ListTagsForResource",
        "dlm:UpdateLifecyclePolicy",
        "dlm:DeleteLifecyclePolicy"
      ],
      "Resource": "arn:aws:dlm:{{REGION}}:{{ACCOUNT_ID}}:policy/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Application": "lomi",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/ManagedBy": "terraform"
        }
      }
    }
  ]
}
