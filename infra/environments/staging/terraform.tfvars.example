# Replace every example identifier before planning.
account_id = "123456789012"
region = "ap-south-1"
subnet_id = "subnet-0123456789abcdef0"
zone_id = null # Set an existing Route 53 zone ID to manage both DNS records.
app_hostname = "review.staging.example.com"
api_hostname = "api-review.staging.example.com"
model_secret_arn = "arn:aws:secretsmanager:ap-south-1:123456789012:secret:lomi/staging/model-EXAMPL"
# Set this when deploying with the scoped staging operator policies.
# workload_permissions_boundary_arn = "arn:aws:iam::123456789012:policy/LomiStagingWorkloadBoundary"
ingress_cidrs = ["203.0.113.10/32"]
# publish.sh writes app_image and web_image into release.auto.tfvars.json.
