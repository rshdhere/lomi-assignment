{
  "title": "Lomi \u00b7 Live load test",
  "uid": "lomi-load-live",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["lomi", "load-test"],
  "timezone": "utc",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API requests per second",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lomi_http_requests_total[1m]))",
          "legendFormat": "API requests per second",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Extractions per minute",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum(rate(lomi_extraction_attempts_total{outcome=\"extracted\"}[1m]))",
          "legendFormat": "Extractions per minute",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Queued versions",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(lomi_queue_queued)",
          "legendFormat": "Queued versions",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Oldest queued version",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(lomi_queue_oldest_queued_seconds)",
          "legendFormat": "Oldest queued version",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API latency by route \u00b7 p95",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method, route) (rate(lomi_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{method}} {{route}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Postgres extraction state",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(lomi_queue_queued)",
          "legendFormat": "Queued",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "max(lomi_queue_extracting)",
          "legendFormat": "Extracting",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "max(lomi_queue_expired_claims)",
          "legendFormat": "Expired claims",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        }
      },
      "description": "Durable version state observed by the worker. Expired claims are eligible for recovery."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Worker extraction duration",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(lomi_extraction_duration_seconds_bucket{outcome=\"extracted\"}[2m])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lomi_extraction_duration_seconds_bucket{outcome=\"extracted\"}[2m])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        }
      },
      "description": "Elapsed worker processing time for successful extractions. Queue wait is tracked separately."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Extraction attempts by outcome",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(lomi_extraction_attempts_total[1m]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "API responses by status class",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(lomi_http_requests_total[1m]))",
          "legendFormat": "{{status_class}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Oldest queued version",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(lomi_queue_oldest_queued_seconds)",
          "legendFormat": "Waiting",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        }
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "API and worker events",
      "description": "Expand a log entry and select its Trace link to open the corresponding Jaeger trace.",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "{service_name=~\"lomi-api|lomi-worker\"}",
          "maxLines": 100,
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "showCommonLabels": false,
        "enableLogDetails": true,
        "wrapLogMessage": true
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Recent extraction traces",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "jaeger",
        "uid": "jaeger"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "search",
          "service": "lomi-worker",
          "limit": 20,
          "datasource": {
            "type": "jaeger",
            "uid": "jaeger"
          }
        }
      ],
      "options": {
        "showHeader": true
      }
    }
  ]
}
